# ==========================================
# NURCERY MONOREPO ENVIRONMENT CONFIGURATION
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
API_URL=http://localhost:5000/api

# Database (PostgreSQL default, with sqlite fallback for zero-dependency local runs)
DB_CLIENT=sqlite3
# For PostgreSQL:
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=nurcery_user
# DB_PASSWORD=nurcery_secure_password
# DB_NAME=nurcery_db
# DATABASE_URL=postgres://nurcery_user:nurcery_secure_password@localhost:5432/nurcery_db
DB_FILE=./data/nurcery_dev.sqlite

# Auth & Security
JWT_ACCESS_SECRET=your_dev_jwt_access_secret_min_32_characters_long_12345
JWT_REFRESH_SECRET=your_dev_jwt_refresh_secret_min_32_characters_long_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_dev_cookie_signing_secret_xyz

# Storage (Cloudinary with local-disk fallback)
STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=placeholder
# CLOUDINARY_API_KEY=placeholder
# CLOUDINARY_API_SECRET=placeholder

# Email (SMTP adapter with dev console logger fallback)
EMAIL_DRIVER=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=placeholder
# SMTP_PASS=placeholder
# SMTP_FROM="Green Valley Nursery <no-reply@greenvalley.local>"

# Sample Data Marker
DEV_SAMPLE_DATA=true

