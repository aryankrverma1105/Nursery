{
  "name": "nurcery-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated Horticulture Nursery Platform: Public Catalogue, Mobile-First Operations App, and Ledger-Based Inventory Management",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:e2e": "playwright test",
    "migrate": "npm run migrate --workspace=server",
    "seed": "npm run seed --workspace=server",
    "seed:real": "npm run seed:real --workspace=server",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.1.2"
  }
}
